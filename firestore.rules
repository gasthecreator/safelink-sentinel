rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Relief Feed posts. Public read (it's a public feed). Anyone signed in
    // (the app always signs in anonymously before writing - see
    // firestoreApi.js) can create their own post or upvote/donate on
    // someone else's. Only the post's owner can edit its content or
    // delete it. `verified` can never be set by a client - there's no
    // moderation/admin flow built yet, so it stays false until one exists.
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.verified == false;

      allow update: if request.auth != null && (
        // Owner editing their own post, but still can't self-verify.
        (resource.data.userId == request.auth.uid
          && request.resource.data.verified == resource.data.verified)
        ||
        // Anyone else may only touch the upvote/donate fields.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['upvoteCount', 'voters', 'priorityScore', 'currentAmount', 'neededItems'])
      );

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // General (not-tied-to-a-post) donations. Write-only from the client -
    // nothing in the app reads these back, so there's no reason to expose
    // read access.
    match /generalDonations/{donationId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
