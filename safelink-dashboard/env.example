# SafeLink Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (Backend Server)
# For production, use your Render backend URL
VITE_API_BASE_URL=https://safelink-api.onrender.com

# Firebase - get these from Firebase Console > Project settings > Your apps.
# Backs exactly two things: Relief Feed posts/upvotes (Firestore collection
# "posts") and Donate (Firestore collection "generalDonations"). Requires
# Firestore + Anonymous Authentication enabled on the project. See
# firestore.rules at the repo root for the security rules to deploy.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Development (optional)
# VITE_API_BASE_URL=http://localhost:4000

