# SafeLink Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# API Base URL (Backend Server)
# For production, use your Render backend URL
VITE_API_BASE_URL=https://safelink-api.onrender.com

# (No Firebase vars here - verified the app doesn't read them. Firebase
# config is hardcoded in src/lib/firebase/firebase.js, currently pointed
# at a shared project ("lifeline-61a5e") from the original hackathon team.
# It backs exactly two things: Relief Feed posts/upvotes (Firestore
# collection "posts") and Donate (Firestore collection "generalDonations").
# Swap the config in that file directly if you move to your own project.)

# Development (optional)
# VITE_API_BASE_URL=http://localhost:4000

