# SafeLink Backend Server - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=4000

# Frontend URL (for CORS)
# Add multiple URLs separated by commas if needed
FRONTEND_URL=https://safelink-dashboard.onrender.com

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key. This one is sent to every browser that opens the dashboard's shelter map, so it must
# be a key used for nothing else, restricted in Google Cloud (Credentials, Application restrictions: HTTP
# referrers = your dashboard's address; API restrictions: Maps JavaScript / Places only).
GOOGLE_MAPS_KEY=your_google_maps_key_here

# Google API Key (fallback for the server's own calls only; never sent to browsers)
GOOGLE_API_KEY=your_google_api_key_here

# Admin token for actions that delete or change other people's data (clearing rescue records, removing a
# peer, sending a system alert, forcing a Sentinel run). At least 16 characters; make one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave unset and those actions are simply turned off. Use it as:  Authorization: Bearer <token>
ADMIN_TOKEN=

# How many proxies sit in front of the server (Render: 1; leave unset to use that in production).
# TRUST_PROXY=1
# Requests per minute per client address (default 300). Writes (40/min) and the endpoints that call Gemini,
# Maps or weather services (12/min) have their own, lower limits.
# RATE_LIMIT_PER_MINUTE=300
# Put every data file in one directory (default: where each file lives today).
# SAFELINK_DATA_DIR=/var/data
# (No Firebase vars here - verified nothing server-side reads them. The
# dashboard's Firebase config lives in safelink-dashboard/src/lib/firebase/
# firebase.js instead, hardcoded rather than env-sourced.)

# Disaster Sentinel scheduler (GDACS polling + proximity alerts)
# Leave unset/false in dev to avoid hitting GDACS/ipapi on every restart.
ENABLE_SENTINEL_SCHEDULER=false

