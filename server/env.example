# SafeLink Backend Server - Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=4000

# Frontend URL (for CORS)
# Add multiple URLs separated by commas if needed
FRONTEND_URL=https://safelink-dashboard.onrender.com

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key
GOOGLE_MAPS_KEY=your_google_maps_key_here

# Google API Key (alternative/fallback)
GOOGLE_API_KEY=your_google_api_key_here

# (No Firebase vars here - verified nothing server-side reads them. The
# dashboard's Firebase config lives in safelink-dashboard/src/lib/firebase/
# firebase.js instead, hardcoded rather than env-sourced.)

# Disaster Sentinel scheduler (GDACS polling + proximity alerts)
# Leave unset/false in dev to avoid hitting GDACS/ipapi on every restart.
ENABLE_SENTINEL_SCHEDULER=false

