{
  "name": "safelink-mesh-ai",
  "version": "1.0.0",
  "description": "SafeLink Mesh AI - Offline mesh networking with AI-powered routing for emergency communications",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "safelink-dashboard",
    "app"
  ],
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "dev:server": "npm start -w server",
    "dev:dashboard": "npm run dev -w safelink-dashboard",
    "dev:app": "npm start -w app",
    "build:dashboard": "npm run build -w safelink-dashboard",
    "test": "npm run test:server && npm run test:app",
    "test:server": "npm test -w server",
    "test:app": "npm test -w app -- --ci",
    "start:windows": "scripts\\start.bat",
    "stop:windows": "scripts\\stop.bat",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format:changed": "node scripts/format-changed.js"
  },
  "keywords": [
    "mesh-network",
    "offline",
    "p2p",
    "encryption",
    "react-native",
    "emergency-communications"
  ],
  "author": "SafeLink Team",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasthecreator/safelink-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/gasthecreator/safelink-sentinel/issues"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.2",
    "eslint": "^8.57.1",
    "prettier": "^2.8.8",
    "typescript": "^5.3.3"
  }
}
