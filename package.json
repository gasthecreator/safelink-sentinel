{
  "name": "safelink-mesh-ai",
  "version": "1.0.0",
  "description": "SafeLink Mesh AI - Offline mesh networking with AI-powered routing for emergency communications",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "safelink-dashboard",
    "app"
  ],
  "scripts": {
    "start": "scripts\\start.bat",
    "stop": "scripts\\stop.bat",
    "start:app": "scripts\\start-app.bat",
