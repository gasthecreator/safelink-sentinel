    "offline",
    "p2p",
    "encryption",
    "react-native",
    "emergency-communications"
  ],
  "author": "SafeLink Team",
  "license": "MIT",
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.2",
    "eslint": "^8.57.1",
    "prettier": "^2.8.8",
    "typescript": "^5.3.3"
  }
}
